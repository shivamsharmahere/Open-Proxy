{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OPENPROXY (all upstream groups)",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "{env:NIM_PROXY_KEY}",
        "timeout": false
      },
      "models": {
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (NIM)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "z-ai/glm-5.3-free": {
          "name": "GLM-5.3 Free (TokenRouter)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "nim/moonshotai/kimi-k3",
  "small_model": "nim/moonshotai/kimi-k3",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24000
  }
}
